# ── Database ─────────────────────────────────────────────
# Any PostgreSQL 14+. DATABASE_URL is used by the app, DIRECT_URL by migrations.
# Supabase on Vercel: DATABASE_URL = transaction pooler (port 6543) + ?pgbouncer=true&connection_limit=1
#                     DIRECT_URL   = session pooler (port 5432)
# Single server / local: set both to the same direct connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/iprams?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/iprams?schema=public"
# Separate database used only by `npm test` (it is wiped by the tests)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/iprams_test?schema=public"

# ── Application ──────────────────────────────────────────
# Public base URL, used in email links and CSRF origin checks
APP_URL="https://pr.imperialedtech.example"
# 64+ random hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
SESSION_TTL_HOURS="12"
# File storage: "local" (STORAGE_DIR, single server) or "supabase" (private bucket; required on Vercel)
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
SUPABASE_URL=""
# Server-side only. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="iprams-private"
# Vercel caps request bodies at ~4.5 MB: use 4 there
MAX_UPLOAD_MB="10"

# ── Email (optional; in-app notifications work without it) ─
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="IPRAMS <no-reply@example.com>"

# ── Initial administrator (used by `npm run setup:admin`) ─
ADMIN_EMAIL=""
ADMIN_NAME=""

# ── Development seed only ────────────────────────────────
SEED_DEMO_PASSWORD=""
